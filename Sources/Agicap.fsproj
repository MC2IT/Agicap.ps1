<Project Sdk="Microsoft.NET.Sdk">
	<PropertyGroup>
		<Company>MC2IT</Company>
		<Copyright>© MC2IT</Copyright>
		<Description>An Agicap API client library for PowerShell.</Description>
		<Product>Agicap for PowerShell</Product>
		<Version>0.9.0</Version>
	</PropertyGroup>

	<PropertyGroup>
		<AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
		<AssemblyName>Mc2it.Agicap.PowerShell</AssemblyName>
		<CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
		<HotReloadAutoRestart>true</HotReloadAutoRestart>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>
		<OutDir>../Binaries</OutDir>
		<RootNamespace>Mc2it.Agicap</RootNamespace>
		<SatelliteResourceLanguages>en</SatelliteResourceLanguages>
		<TargetFramework>net10.0</TargetFramework>
	</PropertyGroup>

	<ItemGroup>
		<InternalsVisibleTo Include="$(RootNamespace).Tests" />
		<PackageReference Update="FSharp.Core" Version="10.1.401" />
		<PackageReference Include="Mc2it.Agicap" Version="0.9.0" />
		<PackageReference Include="System.Management.Automation" Version="7.6.6" />
		<!-- TODO <ProjectReference Include="../../../net/Agicap/Sources/Agicap.csproj" /> -->
	</ItemGroup>

	<ItemGroup>
		<Compile Include="NotImportedEntry.fs" />
		<Compile Include="Authentication/*.fs" />
		<Compile Include="ChartOfAccounts/*.fs" />
		<Compile Include="Organizations/*.fs" />
	</ItemGroup>
</Project>
